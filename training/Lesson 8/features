# Наследование
Наследование позволяет создавать новые классы на основе уже существующих.
Новый класс может расширять функциональность существующего.
Зачем: Избежать дублирования кода.
from abc import ABC,
# Родительский абстрактный класс
class Person(ABC):
    def __init__(self, name, age):
        self.name = name
        self.age = age
    @abstractmethod
    def get_role(self) -> str:
        pass

# Дочерние классы
class Student(Person):
    def __init__(self, name, age, course):
        super().__init__(name, age)
        self.course = course
    def study(self):
        print("Изучаю материал")
    def get_role(self):
        return "student"

class Worker(Person):
    def __init__(self, name, age, salary): super().__init__(name, age) self.salary = salary
    def work(self): print("Выполняю задачи")
    def get_role(self): return "worker"
